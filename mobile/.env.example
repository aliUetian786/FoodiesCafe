# =========================================================================
# Foodies Cafe Mobile Environment Configuration
# =========================================================================

# 1. Backend Server API URL (Defaults to auto-detecting your computer's LAN IP via Metro)
# If your physical phone cannot reach your computer, replace with your Wi-Fi LAN IP (e.g. http://192.168.1.15:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000

# 2. CARTO Basemaps API Key (OPTIONAL)
# By default, FoodiesCafe now uses OpenStreetMap German & HOT mirrors which are 100% FREE with NO API key needed and NO watermarks.
# If you wish to use CARTO Voyager raster tiles, get a free key at https://carto.com/basemaps/apikey (Free 5 million req/month)
# and paste it here:
# EXPO_PUBLIC_CARTO_API_KEY=your_free_carto_api_key_here

# 3. Google Maps API Key (OPTIONAL)
# If you ever switch to Google Maps SDK, add your Google Cloud API key here:
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere
